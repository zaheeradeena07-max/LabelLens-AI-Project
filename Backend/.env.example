PORT=5001
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MONGO_URI=mongodb://localhost:27017/health-backend
# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production cookies require HTTPS; SameSite=None supports a separate frontend/API site.
COOKIE_SAME_SITE=none
# Optional: cached OCR model directory (defaults to the OS temporary directory).
TESSERACT_CACHE_DIR=
# Optional: alternate Tesseract language model URL or directory. Defaults to Tesseract's CDN.
TESSERACT_LANG_PATH=
